all:
  hosts:
    localhost:
      ansible_connection: local

  vars:
    ZBUILDER_PUBKEY: "~/.ssh/id_ed25519.pub"
    ZBUILDER_SYSUSER: sysadmin
    ZBUILDER_ENV: demo

  children:
    debian:
      hosts:
        debian01.kvm.lan:
        debian02.kvm.lan:
          zb_disks: [ 5 ]
      vars:
        ZBUILDER_PROVIDER:
          CLOUD: kvm-local
          VM_OPTIONS:
            template: debian-13-base.qcow2
            vcpu: 2
            memory: 2048
            size: 20
            disks: "{{ zb_disks | default([]) }}"

    ubuntu:
      hosts:
        ubuntu01.kvm.lan:
        ubuntu02.kvm.lan:
          zb_disks: [ 5 ]
      vars:
        ZBUILDER_PROVIDER:
          CLOUD: kvm-local
          VM_OPTIONS:
            template: ubuntu-26.04-base.qcow2
            vcpu: 2
            memory: 2048
            size: 20
            disks: "{{ zb_disks | default([]) }}"
