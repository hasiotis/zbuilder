all:
  hosts:
    localhost:
      ansible_connection: local

  vars:
    ZBUILDER_PUBKEY: "~/.ssh/id_ed25519.pub"
    ZBUILDER_SYSUSER: sysadmin
    ZBUILDER_ENV: demo

  children:
    demo:
      hosts:
        # The addresses are static and outside of nothing in particular: the
        # libvirt default network hands out the whole 192.168.122.0/24 over
        # DHCP, so keep these high and away from anything else on virbr0.
        kvm1.kvm.loc:
          ansible_host: 192.168.122.101
          zb_ip: 192.168.122.101
        kvm2.kvm.loc:
          ansible_host: 192.168.122.102
          zb_ip: 192.168.122.102
          zb_disks:
            - 5
      vars:
        ZBUILDER_PROVIDER:
          CLOUD: kvmlocal
          VM_OPTIONS:
            pool: default
            network: default
            template: debian-13-base.qcow2
            vcpu: 1
            memory: 1024
            size: 10
            disks: "{{ zb_disks | default([]) }}"
            nameserver: 192.168.122.1
            searchdomain: kvm.loc
            ipconfig: "ip={{ zb_ip }}/24,gw=192.168.122.1"
